# ============================================================================
# SHARED configuration — copy to .env at the repo root.
#
# Only put a variable here if more than one workspace genuinely needs it, or if
# Docker Compose needs it for interpolation. Anything belonging to a single app
# goes in that app's own file instead:
#
#   apps/api/.env.example
#   apps/web/.env.example
#
# Precedence, most specific first:
#   real environment variables  >  <app>/.env  >  this file
# ============================================================================

# ---- Shared by every workspace --------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# ---- Database --------------------------------------------------------------
# The single source of truth. Deliberately NOT duplicated into apps/api/.env:
# drizzle-kit and the migration scripts read only this file, so migrations can
# never be applied to a different database than the API talks to.
POSTGRES_USER=cigbuddy
POSTGRES_PASSWORD=cigbuddy
POSTGRES_DB=cigbuddy
# If a Postgres is already installed on this machine it will own 5432 and the
# container's mapping will be shadowed — change both lines to e.g. 5433.
POSTGRES_PORT=5432
# Prefer 127.0.0.1 over localhost so Node cannot resolve it to an IPv6 address
# the container isn't listening on.
DATABASE_URL=postgres://cigbuddy:cigbuddy@127.0.0.1:5432/cigbuddy

# ---- Docker Compose only ---------------------------------------------------
# Host-side port mappings. Inside the Compose network the containers always
# talk to each other on 3000, so changing these cannot break service wiring.
API_HOST_PORT=3000
WEB_HOST_PORT=8080
