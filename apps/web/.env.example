# ============================================================================
# apps/web — copy to apps/web/.env
#
# Read by Vite in development and by `node --env-file-if-exists` in production
# (see the `start` script). Values here override the shared .env at the repo
# root, and are themselves overridden by real environment variables.
#
# PUBLIC_* variables are exposed to the browser and MUST live in this file —
# SvelteKit only reads them from this app's directory.
# ============================================================================

# Where server-side loads and form actions reach the API. Prefer 127.0.0.1 over
# localhost so Node cannot resolve it to an IPv6 address the API isn't on.
API_URL=http://127.0.0.1:3000

# Exposed to the browser.
PUBLIC_APP_NAME=CigaretteBuddy

# ---- Development -----------------------------------------------------------
# Port for `pnpm dev` (the Vite dev server).
WEB_DEV_PORT=5173

# ---- Production (`pnpm start`, i.e. the adapter-node server) ---------------
PORT=4173
# adapter-node rejects form POSTs whose Origin header does not match this.
ORIGIN=http://localhost:4173

# ---- Video rooms -----------------------------------------------------------
# WebSocket the browser opens for room signaling. Leave empty to use the page's
# own host (`ws(s)://<host>/api/ws`), which works in development through the
# Vite proxy and in production behind a reverse proxy that forwards /api to the
# API. Set it explicitly when the API is reached on a different host or port,
# e.g. ws://localhost:3000/api/ws (docker-compose does this for you).
PUBLIC_SIGNALING_URL=
