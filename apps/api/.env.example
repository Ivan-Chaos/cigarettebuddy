# ============================================================================
# apps/api — copy to apps/api/.env
#
# Values here override the shared .env at the repo root, and are themselves
# overridden by real environment variables (which is how Compose configures
# the container). Every variable below is validated by src/env.ts at boot.
# ============================================================================

# Port and interface the HTTP server binds to.
API_PORT=3000
API_HOST=0.0.0.0

# Comma-separated origins allowed to call the API directly. In development this
# is the Vite dev server; the SvelteKit server itself is not a browser origin
# and never needs to be listed.
CORS_ORIGIN=http://localhost:5173

# Uncomment to point this app at a different database than the shared one —
# note that `pnpm db:migrate` will still use the root .env.
# DATABASE_URL=postgres://cigbuddy:cigbuddy@localhost:5432/cigbuddy

# Uncomment to override the shared log level for the API only.
# LOG_LEVEL=debug
